{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topshelf.local/schemas/v1/decision.schema.json",
  "title": "TOS Decision Record v1",
  "description": "Authoritative schema for one record in .tos/decisions.yaml schema_version 1.",
  "x-tos-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "authority",
    "decided_on",
    "decision",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TOS-DEC-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "decided_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TOS-DEC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "supersedes_legacy_labels": {
      "description": "Preserves historical non-decision labels previously stored in supersedes without pretending they are decision IDs.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
