{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t34ch.com/schemas/tos/contract-change.schema.json",
  "title": "TOS Contract Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change", "review", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "contract_id",
        "requested_by",
        "requested_on",
        "reason",
        "status",
        "current_version",
        "proposed_version",
        "change_class",
        "draft_contract_path",
        "compatibility_summary",
        "affected_contracts"
      ],
      "properties": {
        "change_id": { "type": "string", "pattern": "^TOS-CHG-[0-9]{4}-[0-9]{3}$" },
        "contract_id": { "type": "string", "pattern": "^TOS-CTR-[0-9]{3}$" },
        "requested_by": { "type": "string", "minLength": 1 },
        "requested_on": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["draft", "proposed", "under_review", "approved", "rejected"]
        },
        "current_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "proposed_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "change_class": { "enum": ["patch", "minor", "major"] },
        "draft_contract_path": { "type": "string", "minLength": 1 },
        "compatibility_summary": { "type": "string", "minLength": 1 },
        "affected_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^TOS-CTR-[0-9]{3}$" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steward", "auditor", "owner"],
      "properties": {
        "steward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "status"],
          "properties": {
            "agent_id": { "type": "string", "minLength": 1 },
            "status": { "enum": ["authored", "pending"] },
            "performed_by": { "type": "string", "minLength": 1 }
          }
        },
        "auditor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "status"],
          "properties": {
            "agent_id": { "type": "string", "minLength": 1 },
            "status": { "enum": ["pending", "passed", "failed"] },
            "performed_by": { "type": "string", "minLength": 1 },
            "reviewed_on": { "type": "string", "format": "date" },
            "findings": { "type": "string", "minLength": 1 }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "status"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "status": { "enum": ["pending", "approved", "rejected"] },
            "decided_on": { "type": "string", "format": "date" },
            "decision_record": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target_contract_path", "authorized_by", "authorized_on"],
      "properties": {
        "status": { "enum": ["pending", "authorized", "rejected"] },
        "target_contract_path": {
          "type": "string",
          "pattern": "^contracts/.+\\.ya?ml$"
        },
        "authorized_by": { "type": "string", "minLength": 1 },
        "authorized_on": { "type": "string", "format": "date" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "change": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "required": ["promotion"],
        "properties": {
          "review": {
            "properties": {
              "steward": { "required": ["performed_by"] },
              "auditor": { "required": ["performed_by", "reviewed_on", "findings"] },
              "owner": { "required": ["decided_on", "decision_record"] }
            }
          }
        }
      }
    }
  ]
}
