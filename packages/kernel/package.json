  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./truth": {
      "types": "./dist/truth.d.ts",
      "import": "./dist/truth.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "import": "./dist/reconcile.js"
    },
    "./requirements": {
      "types": "./dist/requirements.d.ts",
