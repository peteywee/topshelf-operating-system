{
  "name": "topshelf-operating-system",
  "version": "0.2.1",
  "private": true,
  "description": "TopShelf Operating System runtime and contract foundation",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test:doc-freshness": "node --test scripts/check-doc-freshness.test.mjs scripts/check-doc-freshness-anchor.test.mjs scripts/check-doc-freshness-hardening.test.mjs",
    "doc:freshness": "node scripts/check-doc-freshness.mjs --registry .tos/document-freshness.json --ref HEAD",
    "contract:guard": "node scripts/verify-contract-change-control.mjs",
    "tos": "node scripts/run-tos.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
